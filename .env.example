# Supabase (required for web app)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase secrets (set via: npx supabase secrets set KEY=VALUE)
# SUPABASE_URL                 — auto-available in Edge Functions
# SUPABASE_SERVICE_ROLE_KEY    — auto-available in Edge Functions
# TELEGRAM_BOT_TOKEN           — from @BotFather
# TELEGRAM_OWNER_CHAT_ID       — your numeric Telegram ID
# TELEGRAM_WEBHOOK_SECRET      — random string for webhook validation
# ANTHROPIC_API_KEY            — Claude API key
# GROQ_API_KEY                 — Groq Whisper API key
